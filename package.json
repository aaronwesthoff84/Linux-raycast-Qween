{
  "name": "linux-cast",
  "version": "1.0.0",
  "description": "Raycast-like productivity launcher for Linux",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dev": "nodemon --watch electron --watch src --exec electron .",
    "test": "mocha tests/*.test.js"
  },
  "keywords": [
    "launcher",
    "productivity",
    "linux",
    "raycast"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fuse.js": "^7.0.0",
    "lowdb": "^6.0.0",
    "node-fetch": "^3.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "mocha": "^12.0.0",
    "nodemon": "^3.0.0"
  },
  "build": {
    "appId": "com.linuxcast.app",
    "productName": "LinuxCast",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
